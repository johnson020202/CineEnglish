# CineEnglish Backend Configuration Example (Sanitized)

# Application Port & Host
HOST=0.0.0.0
PORT=8008

# JWT & Security (Generate a random 32-character string in production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./data/cineenglish.db

# Storage Directories
STORAGE_DIR=./data
RECORDINGS_DIR=./data/recordings
CACHE_DIR=./data/cache

# Optional Subtitle API Keys (OpenSubtitles REST API v1)
OPENSUBTITLES_API_KEY=

# Optional Fallback AI API Key (Can also be configured directly in Android App Settings)
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
DEFAULT_CHAT_MODEL=deepseek-chat
DEFAULT_TTS_VOICE=alloy
